FAJR_ENV=development
FAJR_ADDR=:8080
FAJR_DATABASE_URL=postgres://fajr_app:fajr@localhost:5434/fajr?sslmode=disable
FAJR_LOG_LEVEL=debug

FAJR_MEDIA_HOSTS=video.example.edu.bd,tube.example.com
FAJR_S3_ENDPOINT=localhost:9000
FAJR_S3_BUCKET=fajr-media
FAJR_S3_ACCESS_KEY=fajr
FAJR_S3_SECRET_KEY=fajrsecret
FAJR_S3_USE_SSL=false
FAJR_BANK_ACCOUNT_NAME=Darul Uloom
FAJR_BANK_ACCOUNT_NUMBER=1234567890
FAJR_BANK_NAME=Islami Bank
FAJR_BANK_BRANCH=Sylhet
FAJR_PUBLIC_URL=http://localhost:8080
FAJR_SSLCOMMERZ_STORE_ID=
FAJR_SSLCOMMERZ_STORE_PASSWORD=
FAJR_SSLCOMMERZ_SANDBOX=true
FAJR_BKASH_USERNAME=
FAJR_BKASH_PASSWORD=
FAJR_BKASH_APP_KEY=
FAJR_BKASH_APP_SECRET=
FAJR_BKASH_SANDBOX=true
FAJR_SMS_URL=
FAJR_SMS_METHOD=POST
FAJR_SMS_ENCODING=form
FAJR_SMS_BODY=msisdn={to}&sms={message}&sender={sender}
FAJR_SMS_SENDER=FAJR
FAJR_SMS_SUCCESS_CONTAINS=
FAJR_SMS_AUTH_HEADER=

# Fajr AI. Left empty, nothing is sent anywhere and the drafting endpoint says so.
FAJR_ANTHROPIC_API_KEY=
FAJR_AI_MODEL=claude-sonnet-5
