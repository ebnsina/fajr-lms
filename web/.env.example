FAJR_API_URL=http://localhost:8080

# Fajr AI. Left empty, every AI surface says it is not configured and nothing
# is sent anywhere. Provider is one of anthropic, openai, gemini, ollama.
FAJR_AI_PROVIDER=anthropic
FAJR_AI_API_KEY=
FAJR_AI_MODEL=
# Only for ollama, which runs on your own machine and needs no key.
FAJR_AI_BASE_URL=
